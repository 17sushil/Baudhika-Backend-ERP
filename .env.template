PORT=4000
# Swagger UI at /docs. Defaults to on unless NODE_ENV=production; set true/false to override.
SWAGGER_ENABLED=
# Number of reverse proxies in front of the app (e.g. 1 behind one load balancer). Leave empty when none.
TRUST_PROXY=

# ---- Postgres (master connection; also the fallback for tenants without their own credentials)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
MASTER_DB_NAME=
MASTER_DB_POOL_MAX=10

# Optional: separate role used only to CREATE ROLE / CREATE DATABASE for new tenants
# (needs CREATEDB + CREATEROLE). When empty, the master connection is used.
PROVISIONER_DB_USER=
PROVISIONER_DB_PASS=

# ---- Tenant databases
# Empty template DB used only to generate tenant migrations.
TENANT_DB_NAME=tenant_template
TENANT_DB_POOL_MAX=5
TENANT_POOL_MAX_TENANTS=200
TENANT_POOL_IDLE_MS=600000
TENANT_DB_CONNECTION_LIMIT=30
MIGRATION_CONCURRENCY=4
# 32 random bytes, base64. Encrypts tenant DB passwords in the master DB. Back it up: losing it
# means losing access to every tenant DB.   openssl rand -base64 32
TENANT_SECRETS_KEY=

# ---- Auth (two different secrets, each >= 32 chars)   openssl rand -base64 48
PLATFORM_JWT_SECRET=
TENANT_JWT_SECRET=

# ---- Domains / frontend
BASE_DOMAIN=
# Extra allowed browser origins, comma separated (e.g. http://localhost:3000)
CORS_ORIGINS=
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

MAIL_DRIVER=console

# Only for npm run seed:platform-admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
